# Copy to deploy/.env. Supply unique values on the host; never commit that file.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Generate a Base64-encoded random secret containing at least 32 bytes.
AUTH_JWT_SECRET=
# Optional. Empty means no paid model calls; capability replies still work.
DEEPSEEK_API_KEY=
HMS_IMAGE_TAG=v0.2.1
HMS_BIND_ADDRESS=127.0.0.1
HMS_HTTP_PORT=8080
